---
// src/pages/support.astro
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Support NPCollab" breadcrumb="Support NPCollab" section="support">

  <div class="page-header animate-in">
    <div class="label">Community</div>
    <h1>Support NPCollab</h1>
    <p>NPCollab is free, ad-free, and will always remain so. Help us cover running costs.</p>
  </div>

  <div class="prose animate-in delay-1">
    <p>Building and maintaining NPCollab takes clinical expertise, time, and a small amount of money for hosting and infrastructure. We'll never show ads or sell data. If this resource has helped your practice, please consider a small contribution.</p>

    <div class="highlight-box">
      <h4>Running Costs — Full Transparency</h4>
      <ul>
        <li>Domain registration (npcollab.com) — ~$20 AUD/year</li>
        <li>cPanel shared hosting — ~$60–120 AUD/year</li>
        <li>Analytics (Plausible or Umami self-hosted) — $0–$108 AUD/year</li>
        <li>Content development — voluntary NP contributors</li>
      </ul>
    </div>

    <div class="funding-grid">
      <div class="funding-card featured">
        <span class="f-icon">☕</span>
        <h4>Buy Me a Coffee</h4>
        <p>A one-off small contribution to say thanks. Every coffee keeps the site running.</p>
        <a href="https://buymeacoffee.com" target="_blank" rel="noopener" class="btn-primary" style="width:100%;justify-content:center">Support on BMC</a>
      </div>
      <div class="funding-card">
        <span class="f-icon">🧡</span>
        <h4>Ko-fi</h4>
        <p>One-off or recurring monthly support — completely optional.</p>
        <a href="https://ko-fi.com" target="_blank" rel="noopener" class="btn-navy" style="width:100%;justify-content:center">Support on Ko-fi</a>
      </div>
      <div class="funding-card">
        <span class="f-icon">🤝</span>
        <h4>Contribute Content</h4>
        <p>Are you an NP? Contribute a module, SOAP note, or quiz question via GitHub.</p>
        <a href="https://github.com" target="_blank" rel="noopener" class="btn-navy" style="width:100%;justify-content:center">Contribute on GitHub</a>
      </div>
      <div class="funding-card">
        <span class="f-icon">📣</span>
        <h4>Spread the Word</h4>
        <p>Share NPCollab with NP students and colleagues. Free and very helpful!</p>
        <button class="btn-navy" style="width:100%;justify-content:center" onclick="navigator.clipboard.writeText('https://npcollab.com').then(()=>alert('Link copied to clipboard!'))">Copy Link to Share</button>
      </div>
    </div>

    <div class="info-box">
      <p>💡 <strong>Transparency:</strong> All contributions go toward site infrastructure only. NPCollab is not a commercial entity and does not generate income for contributors. All contributors remain voluntary.</p>
    </div>
  </div>
</BaseLayout>
