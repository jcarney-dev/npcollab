---
// src/pages/analytics.astro
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Analytics" breadcrumb="Analytics" section="analytics">

  <div class="page-header animate-in">
    <div class="label">Admin</div>
    <h1>Site Analytics</h1>
    <p>Usage overview — connect Plausible or Umami for production analytics.</p>
  </div>

  <!-- Session analytics (localStorage — demo only) -->
  <div class="analytics-grid animate-in delay-1" id="analytics-cards">
    <div class="analytics-card">
      <div class="a-label">Session Page Views</div>
      <div class="a-value" id="stat-pv">—</div>
      <div style="font-size:0.78rem;color:var(--text-muted);margin-top:4px">This browser session</div>
    </div>
    <div class="analytics-card">
      <div class="a-label">Quiz Attempts</div>
      <div class="a-value" id="stat-quiz">—</div>
      <div style="font-size:0.78rem;color:var(--text-muted);margin-top:4px">Total across all modules</div>
    </div>
    <div class="analytics-card">
      <div class="a-label">Modules Accessed</div>
      <div class="a-value" id="stat-modules">—</div>
      <div style="font-size:0.78rem;color:var(--text-muted);margin-top:4px">Unique sections visited</div>
    </div>
  </div>

  <h3 style="color:var(--navy);margin-bottom:12px" class="animate-in delay-2">Quiz Performance</h3>
  <div id="quiz-stats" class="animate-in delay-2">
    <p style="color:var(--text-muted);font-size:0.87rem">No quiz attempts recorded yet. Complete a quiz to see data here.</p>
  </div>

  <div class="info-box animate-in delay-2" style="margin-top:28px">
    <p>📊 <strong>Production analytics options:</strong>
      <a href="https://plausible.io" target="_blank" rel="noopener">Plausible.io</a> (~$9 AUD/month, privacy-first, GDPR compliant, no cookies) or
      <a href="https://umami.is" target="_blank" rel="noopener">Umami</a> (free self-hosted).
      Both are single script tag embeds — uncomment the relevant line in <code>BaseLayout.astro</code>.
    </p>
  </div>

  <div class="info-box animate-in delay-3" style="margin-top:12px;border-left-color:var(--navy);background:#EEF2F8">
    <p>🔒 <strong>Privacy note:</strong> NPCollab does not use tracking cookies or collect personal data. The local session data above is stored only in your browser and never transmitted anywhere.</p>
  </div>
</BaseLayout>

<script>
  // Read local session data written by Quiz component
  try {
    const quizData = JSON.parse(localStorage.getItem('npa_quiz') || '{}');
    const pvData   = JSON.parse(localStorage.getItem('npa_pv')   || '{}');

    // Page views (tracked via a simple script if added)
    const totalPV = Object.values(pvData).reduce((a, b) => a + b, 0);
    document.getElementById('stat-pv').textContent = totalPV || '—';

    // Quiz stats
    const modules = Object.keys(quizData);
    const totalAttempts = modules.reduce((a, m) => a + quizData[m].length, 0);
    document.getElementById('stat-quiz').textContent    = totalAttempts || '—';
    document.getElementById('stat-modules').textContent = modules.length || '—';

    if (modules.length) {
      const container = document.getElementById('quiz-stats');
      container.innerHTML = modules.map(mod => {
        const attempts = quizData[mod];
        const avg = (attempts.reduce((a, r) => a + r.score, 0) / attempts.length).toFixed(1);
        const best = Math.max(...attempts.map(r => r.score));
        return `
          <div class="a-row">
            <span style="text-transform:capitalize;font-weight:500">${mod.toUpperCase()} Module</span>
            <span style="color:var(--text-muted);font-size:0.82rem">${attempts.length} attempt${attempts.length > 1 ? 's' : ''}</span>
            <span>Avg <strong style="color:var(--gold)">${avg}/${attempts[0].total || 20}</strong></span>
            <span>Best <strong style="color:var(--success)">${best}/${attempts[0].total || 20}</strong></span>
          </div>
        `;
      }).join('');
    }
  } catch(e) {
    console.warn('Analytics read error:', e);
  }
</script>
