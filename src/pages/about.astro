---
// src/pages/about.astro
import BaseLayout from '@layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="About & Contributors" breadcrumb="About" section="about">

  <div class="page-header animate-in">
    <div class="label">About</div>
    <h1>About NPCollab</h1>
    <p>A collaborative, free resource built by Australian Nurse Practitioners, for Australian Nurse Practitioners.</p>
  </div>

  <div class="prose animate-in delay-1">

    <h2>Our Mission</h2>
    <p>NPCollab exists to provide Australian Nurse Practitioners and NP students with a free, high-quality, clinically accurate learning resource — particularly for those in their early career or transitioning into advanced practice roles.</p>
    <p>We believe that access to good clinical education should not be gated by expensive subscriptions or fragmented across dozens of websites. NPCollab brings foundations, clinical frameworks, and practice tools into one cohesive, easy-to-navigate space.</p>

    <div class="highlight-box">
      <h4>Core Principles</h4>
      <ul>
        <li><strong>Free forever</strong> — no paywalls, no premium tiers</li>
        <li><strong>No advertising</strong> — content is never influenced by commercial interests</li>
        <li><strong>Evidence-based</strong> — aligned with NMBA, AHPRA, and Australian clinical guidelines</li>
        <li><strong>Collaborative</strong> — open to contributions from practicing Australian NPs</li>
        <li><strong>Privacy-first</strong> — no personal data collected, no tracking cookies</li>
      </ul>
    </div>

    <h2>How the Site is Built</h2>
    <p>NPCollab is built with <a href="https://astro.build" target="_blank" rel="noopener">Astro</a> — a modern static site framework — with all clinical content stored as plain Markdown files in a GitHub repository. This means:</p>
    <ul>
      <li>Content is version-controlled — every change is tracked and reversible</li>
      <li>Any NP with basic GitHub access can suggest edits or additions</li>
      <li>The site is fast, accessible, and works on any device</li>
      <li>No database, no login required to read — just the content</li>
    </ul>

    <h2>Contributing</h2>
    <p>NPCollab is actively seeking Australian NP contributors to:</p>
    <ul>
      <li>Review and improve existing clinical module content</li>
      <li>Write new clinical modules (one module = overview, assessment questions, SOAP note, resources, 20 quiz questions)</li>
      <li>Suggest corrections, updated guidelines, or new resource links</li>
      <li>Share real-world SOAP note examples (de-identified)</li>
    </ul>

    <div class="info-box">
      <p>📬 <strong>Want to contribute?</strong> Reach out via the GitHub repository or the support page. All contributors are acknowledged below.</p>
    </div>

    <h2>Contributors</h2>
    <div class="card" style="margin-top:16px">
      <p style="color:var(--text-muted);font-size:0.9rem;margin:0">Contributors will be listed here as the project grows. If you have contributed content, please get in touch to be acknowledged.</p>
    </div>

    <h2>Disclaimer</h2>
    <p>All content on NPCollab is provided for <strong>educational purposes only</strong>. It does not constitute clinical advice and should not replace your own clinical judgement, the advice of medical colleagues, or current Australian clinical guidelines.</p>
    <p>Always apply your scope of practice, consult current Therapeutic Guidelines, and refer appropriately. NPCollab accepts no liability for clinical decisions made on the basis of content published on this site.</p>

    <p style="margin-top:32px">
      <a href={`${base}support/`} class="btn-primary">☕ Support NPCollab</a>
    </p>

  </div>
</BaseLayout>
