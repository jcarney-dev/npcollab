---
import ModuleLayout from '../../../../layouts/ModuleLayout.astro';
---
<ModuleLayout title="Cardiac" moduleId="cardiac" icon="❤️" description="Chest pain differentials, ACS, heart failure, arrhythmias, hypertension, and ECG basics" activeTab="resources">
  <h3 style="color:var(--navy);margin-bottom:6px;font-family:var(--font-body)">Clinical Resources — Cardiac</h3>
  <p style="color:var(--text-muted);font-size:0.88rem;margin-bottom:24px">Curated Australian resources for NP cardiovascular practice</p>
  <div class="resources-list">
    <a href="https://www.heartfoundation.org.au/conditions/heart-disease/management-guidelines" target="_blank" rel="noopener" class="resource-link">
      <div class="r-icon">❤️</div>
      <div class="r-body"><div class="r-title">Heart Foundation Australia — Clinical Guidelines</div><div class="r-desc">National guidelines for hypertension, heart failure, AF, and ACS management</div></div>
      <div class="r-ext">↗</div>
    </a>
    <a href="https://www.tg.org.au" target="_blank" rel="noopener" class="resource-link">
      <div class="r-icon">💊</div>
      <div class="r-body"><div class="r-title">Therapeutic Guidelines — Cardiovascular</div><div class="r-desc">Australian prescribing guidance for cardiac conditions including ACS, HF, HTN, and AF</div></div>
      <div class="r-ext">↗</div>
    </a>
    <a href="https://www.csanz.edu.au" target="_blank" rel="noopener" class="resource-link">
      <div class="r-icon">🏥</div>
      <div class="r-body"><div class="r-title">CSANZ — Cardiac Society of Australia and New Zealand</div><div class="r-desc">Position statements, guidelines, and educational resources for cardiac practice</div></div>
      <div class="r-ext">↗</div>
    </a>
    <a href="https://www.nps.org.au" target="_blank" rel="noopener" class="resource-link">
      <div class="r-icon">🎯</div>
      <div class="r-body"><div class="r-title">NPS MedicineWise — Cardiovascular</div><div class="r-desc">Evidence-based prescribing resources for antihypertensives, anticoagulants, and lipid therapy</div></div>
      <div class="r-ext">↗</div>
    </a>
    <a href="https://www.racgp.org.au/clinical-resources/clinical-guidelines/key-racgp-guidelines/view-all-racgp-guidelines/guidelines-for-preventive-activities-in-general-pr" target="_blank" rel="noopener" class="resource-link">
      <div class="r-icon">📋</div>
      <div class="r-body"><div class="r-title">RACGP Red Book — Cardiovascular Prevention</div><div class="r-desc">Preventive cardiovascular care, screening, and absolute risk assessment</div></div>
      <div class="r-ext">↗</div>
    </a>
    <a href="https://www.cvdcheck.org.au" target="_blank" rel="noopener" class="resource-link">
      <div class="r-icon">📊</div>
      <div class="r-body"><div class="r-title">Australian CVD Risk Calculator</div><div class="r-desc">Calculate 5-year absolute cardiovascular risk — free online tool aligned with Australian guidelines</div></div>
      <div class="r-ext">↗</div>
    </a>
    <a href="https://litfl.com/ecg-library" target="_blank" rel="noopener" class="resource-link">
      <div class="r-icon">📈</div>
      <div class="r-body"><div class="r-title">LITFL — ECG Library</div><div class="r-desc">Comprehensive free ECG interpretation resource with examples and explanations</div></div>
      <div class="r-ext">↗</div>
    </a>
    <a href="https://www.strokefoundation.org.au" target="_blank" rel="noopener" class="resource-link">
      <div class="r-icon">🧠</div>
      <div class="r-body"><div class="r-title">Stroke Foundation — AF and Anticoagulation</div><div class="r-desc">Resources on AF-related stroke prevention and anticoagulation management</div></div>
      <div class="r-ext">↗</div>
    </a>
  </div>
</ModuleLayout>
