---
import ModuleLayout from '../../../../layouts/ModuleLayout.astro';
import Quiz from '../../../../components/Quiz.astro';
import questions from '../../../../content/modules/cardiac/quiz.json';
---
<ModuleLayout title="Cardiac" moduleId="cardiac" icon="❤️" description="Chest pain differentials, ACS, heart failure, arrhythmias, hypertension, and ECG basics" activeTab="quiz">
  <div style="margin-bottom:24px">
    <h3 style="color:var(--navy);margin-bottom:6px;font-family:var(--font-body)">Cardiac Quiz — 20 Questions</h3>
    <p style="color:var(--text-muted);font-size:0.88rem">Mixed difficulty — covers ACS, heart failure, AF, hypertension, and ECG interpretation. Each question includes a detailed explanation.</p>
  </div>
  <Quiz moduleId="cardiac" questions={questions} />
</ModuleLayout>
