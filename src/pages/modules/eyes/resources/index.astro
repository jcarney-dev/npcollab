---
import ModuleLayout from "../../../layouts/ModuleLayout.astro";
---
<ModuleLayout title="Eyes (Ophthalmology)" moduleId="eyes" icon="👁️" description="Assessment framework, SOAP note, resources, and quiz for ophthalmic presentations" activeTab="resources">
  <h3 style="color:var(--navy);margin-bottom:6px;font-family:var(--font-body)">Clinical Resources — Ophthalmology</h3>
  <p style="color:var(--text-muted);font-size:0.88rem;margin-bottom:24px">Curated Australian and international resources for NP ophthalmic practice</p>
  <div class="resources-list">
    <a href="https://www.ranzco.edu" target="_blank" rel="noopener" class="resource-link">
      <div class="r-icon">🏥</div>
      <div class="r-body"><div class="r-title">RANZCO — Royal Australian and NZ College of Ophthalmologists</div><div class="r-desc">Clinical guidelines, referral pathways, and patient resources</div></div>
      <div class="r-ext">↗</div>
    </a>
    <a href="https://www.tg.org.au" target="_blank" rel="noopener" class="resource-link">
      <div class="r-icon">💊</div>
      <div class="r-body"><div class="r-title">Therapeutic Guidelines — Eye</div><div class="r-desc">Australian prescribing guidelines for ophthalmic conditions (subscription)</div></div>
      <div class="r-ext">↗</div>
    </a>
    <a href="https://www.mims.com.au" target="_blank" rel="noopener" class="resource-link">
      <div class="r-icon">📦</div>
      <div class="r-body"><div class="r-title">MIMS Australia — Ophthalmic Prescribing</div><div class="r-desc">Medicines information, dosing, and prescribing authority reference</div></div>
      <div class="r-ext">↗</div>
    </a>
    <a href="https://www.aao.org/eye-health" target="_blank" rel="noopener" class="resource-link">
      <div class="r-icon">🌐</div>
      <div class="r-body"><div class="r-title">American Academy of Ophthalmology — Eye Health</div><div class="r-desc">Patient education materials and clinical summaries</div></div>
      <div class="r-ext">↗</div>
    </a>
  </div>
</ModuleLayout>
