---
import ModuleLayout from "../../../layouts/ModuleLayout.astro";
import SoapNote from "../../../components/SoapNote.astro";
const sections = [
  { letter: "S", title: "Subjective", fields: [
    { label: "Presenting Complaint", content: "34-year-old female presents with a 2-day history of right eye redness and discharge." },
    { label: "History of Presenting Complaint", content: "Onset 2 days ago, gradual. Right eye only. Yellow-green mucopurulent discharge — worst on waking, causing eyelids to stick together. Associated grittiness and mild itch. Denies pain, photophobia, or any change in visual acuity. No halos or floaters. No headache." },
    { label: "Relevant History", content: "Wears soft daily contact lenses — has continued wearing despite symptoms. No previous eye conditions. No known allergies. No recent systemic illness. No medications. Contact: niece had similar symptoms 5 days ago." },
    { label: "Patient Concerns", content: "Patient concerned about whether antibiotics are required and when contact lenses can be resumed." }
  ]},
  { letter: "O", title: "Objective", fields: [
    { label: "Vital Signs", content: "BP 118/72 mmHg | HR 74 bpm | Temp 36.8°C | SpO2 98% RA" },
    { label: "Examination Findings", content: ["VA: R 6/6, L 6/6 unaided","Pupils: PEARL 4mm bilaterally, no RAPD","EOM: full range, no diplopia","R eye: diffuse conjunctival injection, mucopurulent discharge, lids erythematous. Cornea clear. No foreign body on lid eversion.","L eye: normal","Pre-auricular lymph nodes: not palpable bilaterally"] }
  ]},
  { letter: "A", title: "Assessment", fields: [
    { label: "Primary Diagnosis", content: "Acute bacterial conjunctivitis, right eye (H10.029)" },
    { label: "Differentials Considered", content: ["Viral conjunctivitis — less likely given purulent discharge and epidemiological contact","Allergic conjunctivitis — less likely given unilateral, purulent discharge","Acute angle-closure glaucoma — excluded: no pain, halos, nausea; VA intact; cornea clear"] }
  ]},
  { letter: "P", title: "Plan", fields: [
    { label: "Management", content: ["Chloramphenicol 0.5% eye drops QID for 5 days","Cease contact lenses until 48h post-symptom resolution; discard current lens and case","Hygiene education: handwashing, own towels, avoid touching eyes"] },
    { label: "Safety Netting", content: ["Return immediately if: vision changes, pain increases, photophobia develops, no improvement by 48h","Review in 5–7 days or earlier if required"] }
  ]}
];
---
<ModuleLayout title="Eyes (Ophthalmology)" moduleId="eyes" icon="👁️" description="Assessment framework, SOAP note, resources, and quiz for ophthalmic presentations" activeTab="soap">
  <div style="margin-bottom:20px">
    <h3 style="color:var(--navy);margin-bottom:6px;font-family:var(--font-body)">Example SOAP Note — Acute Red Eye</h3>
    <p style="color:var(--text-muted);font-size:0.88rem">Sample presentation: acute unilateral bacterial conjunctivitis. Click each section to expand.</p>
  </div>
  <SoapNote title="Acute Red Eye — Adult Patient" sections={sections} />
</ModuleLayout>
