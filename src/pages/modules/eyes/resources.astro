---
import ModuleLayout from '../../../../layouts/ModuleLayout.astro';
const resources=[{icon:'🏥',title:'RANZCO — Royal Australian & NZ College of Ophthalmologists',desc:'Clinical guidelines, referral pathways, and patient resources',url:'https://www.ranzco.edu'},{icon:'📄',title:'MJA — Red Eye Clinical Review',desc:'Evidence-based approach to the red eye in primary care',url:'https://www.mja.com.au'},{icon:'💊',title:'Therapeutic Guidelines — Eye',desc:'Australian prescribing guidelines for ophthalmic conditions (subscription)',url:'https://www.tg.org.au'},{icon:'🌐',title:'American Academy of Ophthalmology',desc:'Patient education materials and clinical summaries',url:'https://www.aao.org/eye-health'},{icon:'📦',title:'MIMS Australia — Ophthalmic Prescribing',desc:'Medicines information, dosing, and prescribing authority reference',url:'https://www.mims.com.au'}];
---
<ModuleLayout moduleId="eyes" activeTab="resources" label="Clinical Module" title="👁️ Eyes — Ophthalmology" description="Assessment framework, SOAP note, resources, and quiz for ophthalmic presentations" activePage="eyes">
<h3 style="color:var(--navy);margin-bottom:6px">Clinical Resources — Ophthalmology</h3>
<p style="color:var(--text-muted);font-size:0.88rem;margin-bottom:24px">Curated Australian and international resources for NP ophthalmic practice</p>
<div class="resources-list">{resources.map(r=>(<a href={r.url} target="_blank" rel="noopener" class="resource-link"><div class="r-icon">{r.icon}</div><div class="r-body"><div class="r-title">{r.title}</div><div class="r-desc">{r.desc}</div></div><div class="r-ext">↗ External</div></a>))}</div>
</ModuleLayout>
