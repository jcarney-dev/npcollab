---
import ModuleLayout from '../../../../layouts/ModuleLayout.astro';
---
<ModuleLayout title="Respiratory" moduleId="respiratory" icon="🫁" description="Dyspnoea differentials, asthma, COPD, pneumonia, PE, and spirometry interpretation" activeTab="resources">
  <h3 style="color:var(--navy);margin-bottom:6px;font-family:var(--font-body)">Clinical Resources — Respiratory</h3>
  <p style="color:var(--text-muted);font-size:0.88rem;margin-bottom:24px">Curated Australian resources for NP respiratory practice</p>
  <div class="resources-list">
    <a href="https://www.nationalasthma.org.au" target="_blank" rel="noopener" class="resource-link">
      <div class="r-icon">🫁</div>
      <div class="r-body"><div class="r-title">National Asthma Council Australia</div><div class="r-desc">Australian Asthma Handbook — comprehensive clinical guidance, action plans, and patient resources</div></div>
      <div class="r-ext">↗</div>
    </a>
    <a href="https://copdx.org.au" target="_blank" rel="noopener" class="resource-link">
      <div class="r-icon">💨</div>
      <div class="r-body"><div class="r-title">COPD-X Plan — Lung Foundation Australia</div><div class="r-desc">Australian and New Zealand COPD management guidelines</div></div>
      <div class="r-ext">↗</div>
    </a>
    <a href="https://www.tg.org.au" target="_blank" rel="noopener" class="resource-link">
      <div class="r-icon">💊</div>
      <div class="r-body"><div class="r-title">Therapeutic Guidelines — Respiratory</div><div class="r-desc">Australian antibiotic and management guidance for pneumonia, COPD, and asthma</div></div>
      <div class="r-ext">↗</div>
    </a>
    <a href="https://www.thoracic.org.au" target="_blank" rel="noopener" class="resource-link">
      <div class="r-icon">🏥</div>
      <div class="r-body"><div class="r-title">Thoracic Society of Australia and New Zealand (TSANZ)</div><div class="r-desc">Clinical guidelines, position statements, and specialist referral information</div></div>
      <div class="r-ext">↗</div>
    </a>
    <a href="https://lungfoundation.com.au" target="_blank" rel="noopener" class="resource-link">
      <div class="r-icon">🎗️</div>
      <div class="r-body"><div class="r-title">Lung Foundation Australia</div><div class="r-desc">Patient education, pulmonary rehabilitation resources, and lung health information</div></div>
      <div class="r-ext">↗</div>
    </a>
    <a href="https://www.nps.org.au" target="_blank" rel="noopener" class="resource-link">
      <div class="r-icon">🎯</div>
      <div class="r-body"><div class="r-title">NPS MedicineWise — Respiratory</div><div class="r-desc">Evidence-based inhaler prescribing, antibiotic stewardship, and medicines information</div></div>
      <div class="r-ext">↗</div>
    </a>
    <a href="https://www.smartasthma.com.au" target="_blank" rel="noopener" class="resource-link">
      <div class="r-icon">📋</div>
      <div class="r-body"><div class="r-title">Asthma Written Action Plans — NAC</div><div class="r-desc">Downloadable personalised asthma action plan templates for patients</div></div>
      <div class="r-ext">↗</div>
    </a>
    <a href="https://www.racgp.org.au/clinical-resources/clinical-guidelines/key-racgp-guidelines/view-all-racgp-guidelines/smoking-cessation" target="_blank" rel="noopener" class="resource-link">
      <div class="r-icon">🚭</div>
      <div class="r-body"><div class="r-title">RACGP — Supporting Smoking Cessation Guidelines</div><div class="r-desc">Evidence-based smoking cessation guidance including pharmacotherapy for NPs</div></div>
      <div class="r-ext">↗</div>
    </a>
  </div>
</ModuleLayout>
