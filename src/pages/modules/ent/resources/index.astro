---
import ModuleLayout from '../../../../layouts/ModuleLayout.astro';
---
<ModuleLayout title="ENT (Ears, Nose & Throat)" moduleId="ent" icon="👂" description="Assessment framework, SOAP note, resources, and quiz for ENT presentations" activeTab="resources">
  <h3 style="color:var(--navy);margin-bottom:6px;font-family:var(--font-body)">Clinical Resources — ENT</h3>
  <p style="color:var(--text-muted);font-size:0.88rem;margin-bottom:24px">Curated Australian resources for ENT primary care management</p>
  <div class="resources-list">
    <a href="https://www.tg.org.au" target="_blank" rel="noopener" class="resource-link">
      <div class="r-icon">💊</div>
      <div class="r-body"><div class="r-title">Therapeutic Guidelines — Ear, Nose and Throat</div><div class="r-desc">Gold standard Australian antibiotic and management guidance</div></div>
      <div class="r-ext">↗</div>
    </a>
    <a href="https://www.asohns.org.au" target="_blank" rel="noopener" class="resource-link">
      <div class="r-icon">🏥</div>
      <div class="r-body"><div class="r-title">ASOHNS — Australian Society of Otolaryngology Head and Neck Surgery</div><div class="r-desc">Specialist referral pathways and clinical guidelines</div></div>
      <div class="r-ext">↗</div>
    </a>
    <a href="https://www.nps.org.au" target="_blank" rel="noopener" class="resource-link">
      <div class="r-icon">🎯</div>
      <div class="r-body"><div class="r-title">NPS MedicineWise — Antibiotic Stewardship</div><div class="r-desc">Evidence-based antibiotic guidance for common ENT infections</div></div>
      <div class="r-ext">↗</div>
    </a>
    <a href="https://www.racgp.org.au" target="_blank" rel="noopener" class="resource-link">
      <div class="r-icon">📋</div>
      <div class="r-body"><div class="r-title">RACGP — Clinical Guidelines</div><div class="r-desc">Guidelines applicable to NP primary care including ENT presentations</div></div>
      <div class="r-ext">↗</div>
    </a>
  </div>
</ModuleLayout>
