---
import ModuleLayout from '../../../../layouts/ModuleLayout.astro';
import Quiz from '../../../../components/Quiz.astro';
const res = await fetch(new URL('../../../../content/modules/ent/quiz.json', import.meta.url));
const questions = await res.json().catch(() => []);
---
<ModuleLayout title="ENT (Ears, Nose & Throat)" moduleId="ent" icon="👂" description="Assessment framework, SOAP note, resources, and quiz for ENT presentations" activeTab="quiz">
  <div style="margin-bottom:24px">
    <h3 style="color:var(--navy);margin-bottom:6px;font-family:var(--font-body)">ENT Quiz — 20 Questions</h3>
    <p style="color:var(--text-muted);font-size:0.88rem">Test your knowledge of ENT presentations. Each question includes a detailed explanation.</p>
  </div>
  <Quiz moduleId="ent" questions={questions} />
</ModuleLayout>
