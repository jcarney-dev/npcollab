---
import BaseLayout from "@layouts/BaseLayout.astro";
---
<BaseLayout title="Analytics" breadcrumb="Analytics">
  <div class="page-header">
    <div class="label">Admin</div>
    <h1>Site Analytics</h1>
    <p>Session data only — no external tracking, no cookies. In production, connect Plausible or Umami.</p>
  </div>
  <div id="analytics-display">
    <div class="analytics-grid">
      <div class="analytics-card"><div class="a-label">Total Page Views</div><div class="a-value" id="a-pv">—</div><div class="a-sub">This session</div></div>
      <div class="analytics-card"><div class="a-label">Pages Visited</div><div class="a-value" id="a-pages">—</div><div class="a-sub">Unique sections</div></div>
      <div class="analytics-card"><div class="a-label">Quizzes Completed</div><div class="a-value" id="a-quiz">—</div><div class="a-sub">Total attempts</div></div>
    </div>
    <h4 style="color:var(--navy);margin-bottom:12px;margin-top:8px">Most Visited Pages</h4>
    <div id="a-pages-list"><p style="color:var(--text-muted);font-size:0.87rem">No data yet — browse the site first.</p></div>
    <div id="a-quiz-detail"></div>
  </div>
  <div class="info-box" style="margin-top:24px">
    <p>📊 <strong>For production analytics:</strong> Embed <a href="https://plausible.io" target="_blank" rel="noopener">Plausible.io</a> (~AU$9/month, privacy-first, no cookies) or self-host <a href="https://umami.is" target="_blank" rel="noopener">Umami</a> (free). Both are single script-tag installs. Replace the placeholder comment in <code>BaseLayout.astro</code> with your embed code.</p>
  </div>
</BaseLayout>

<script>
  function loadAnalytics() {
    try {
      const d = JSON.parse(localStorage.getItem("npa") || '{"pv":0,"pages":{},"quiz":{}}');
      const pvEl = document.getElementById("a-pv");
      const pagesEl = document.getElementById("a-pages");
      const quizEl = document.getElementById("a-quiz");
      if (pvEl) pvEl.textContent = String(d.pv || 0);
      const pages = d.pages || {};
      if (pagesEl) pagesEl.textContent = String(Object.keys(pages).length);
      const quizData = d.quiz || {};
      const totalQuiz = Object.values(quizData).reduce((a, v) => a + (Array.isArray(v) ? v.length : 0), 0);
      if (quizEl) quizEl.textContent = String(totalQuiz);
      const pageLabels = {home:"Home",scope:"Scope of Practice",assessment:"Patient Assessment",eyes:"Eyes",ent:"ENT",support:"Support",analytics:"Analytics",about:"About"};
      const topPages = Object.entries(pages).sort((a, b) => b[1] - a[1]).slice(0, 6);
      const listEl = document.getElementById("a-pages-list");
      if (listEl && topPages.length > 0) {
        listEl.innerHTML = topPages.map(([pg, ct]) =>
          `<div style="background:var(--white);border:1px solid var(--border);border-radius:var(--radius-sm);padding:12px 16px;margin-bottom:8px;display:flex;justify-content:space-between;align-items:center"><span style="font-size:0.9rem">${pageLabels[pg]||pg}</span><span style="font-weight:600;color:var(--gold)">${ct} views</span></div>`
        ).join("");
      }
      const quizDetailEl = document.getElementById("a-quiz-detail");
      if (quizDetailEl && Object.keys(quizData).length > 0) {
        quizDetailEl.innerHTML = '<h4 style="color:var(--navy);margin:20px 0 12px">Quiz Performance</h4>' +
          Object.entries(quizData).map(([mod, attempts]) => {
            if (!Array.isArray(attempts) || attempts.length === 0) return "";
            const avg = (attempts.reduce((a, r) => a + (r.score || 0), 0) / attempts.length).toFixed(1);
            return `<div style="background:var(--white);border:1px solid var(--border);border-radius:var(--radius-sm);padding:12px 16px;margin-bottom:8px;display:flex;justify-content:space-between;align-items:center"><span style="font-size:0.9rem;text-transform:capitalize">${mod} quiz — ${attempts.length} attempt(s)</span><span style="font-weight:600;color:var(--gold)">Avg ${avg}/20</span></div>`;
          }).join("");
      }
    } catch(e) { console.error("Analytics load error", e); }
  }
  document.addEventListener("DOMContentLoaded", loadAnalytics);
</script>
