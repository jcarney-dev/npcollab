---
export interface Props { moduleId: string; questions: any[]; }
const { moduleId, questions } = Astro.props;
const questionsJson = JSON.stringify(questions);
---
<div class="quiz-wrapper" id={`quiz-${moduleId}`}>
  <div class="quiz-progress-bar"><div class="quiz-progress-fill" id={`progress-${moduleId}`} style="width:0%"></div></div>
  <div class="quiz-counter" id={`counter-${moduleId}`}>Question 1 of {questions.length}</div>
  <div id={`quiz-body-${moduleId}`}></div>
</div>
<script define:vars={{ moduleId, questionsJson }}>
var questions = JSON.parse(questionsJson);
var state = { current: 0, answers: {}, score: 0, done: false };
function render() {
  var body = document.getElementById("quiz-body-" + moduleId);
  var counter = document.getElementById("counter-" + moduleId);
  var progress = document.getElementById("progress-" + moduleId);
  if (!body) return;
  if (state.done) { renderResults(body); return; }
  var q = questions[state.current];
  var total = questions.length;
  if (progress) progress.style.width = Math.round((state.current / total) * 100) + "%";
  if (counter) counter.textContent = "Question " + (state.current + 1) + " of " + total;
  body.innerHTML = "<div class=\"quiz-question-card\"><div class=\"q-text\">" + q.q + "</div><div class=\"quiz-options\" id=\"opts-" + moduleId + "\">" + q.options.map(function(o,i){return "<button class=\"quiz-option\" data-idx=\""+i+"\" type=\"button\">"+o+"</button>";}).join("") + "</div><div class=\"quiz-explanation\" id=\"exp-" + moduleId + "\">" + q.explanation + "</div></div><div class=\"quiz-nav\"><button class=\"btn-quiz-nav\" id=\"prev-" + moduleId + "\" type=\"button\"" + (state.current===0?" disabled":"") + ">← Previous</button><span style=\"font-size:0.8rem;color:var(--text-muted)\">" + Object.keys(state.answers).length + "/" + total + " answered</span><button class=\"btn-quiz-nav gold\" id=\"next-" + moduleId + "\" type=\"button\">" + (state.current < total-1 ? "Next →" : "Finish Quiz") + "</button></div>";
  body.querySelectorAll(".quiz-option").forEach(function(btn){btn.addEventListener("click",function(){selectAnswer(parseInt(btn.getAttribute("data-idx")));});});
  var prevBtn = document.getElementById("prev-" + moduleId);
  var nextBtn = document.getElementById("next-" + moduleId);
  if (prevBtn) prevBtn.addEventListener("click", function(){if(state.current>0){state.current--;render();}});
  if (nextBtn) nextBtn.addEventListener("click", function(){if(state.current<questions.length-1){state.current++;render();}else{state.done=true;render();}});
  if (state.answers[state.current] !== undefined) revealAnswer(state.answers[state.current], q.correct);
}
function selectAnswer(selected) {
  if (state.answers[state.current] !== undefined) return;
  var q = questions[state.current];
  state.answers[state.current] = selected;
  if (selected === q.correct) state.score++;
  revealAnswer(selected, q.correct);
}
function revealAnswer(selected, correct) {
  var opts = document.querySelectorAll("#opts-" + moduleId + " .quiz-option");
  opts.forEach(function(btn,i){btn.disabled=true;if(i===correct)btn.classList.add("revealed");if(i===selected&&selected!==correct)btn.classList.add("incorrect");});
  var exp = document.getElementById("exp-" + moduleId);
  if (exp) exp.classList.add("show");
}
function renderResults(body) {
  var total = questions.length;
  var pct = Math.round((state.score/total)*100);
  var progress = document.getElementById("progress-" + moduleId);
  var counter = document.getElementById("counter-" + moduleId);
  if (progress) progress.style.width = "100%";
  if (counter) counter.textContent = "Quiz complete";
  var msg = pct>=80 ? "🎉 Excellent work!" : pct>=60 ? "👍 Good effort — review the areas you missed." : "📚 Keep studying — review the module content and retry.";
  body.innerHTML = "<div class=\"quiz-results\"><div class=\"score-circle\"><span class=\"score-num\">" + state.score + "</span><span class=\"score-denom\">/ " + total + "</span></div><h3>" + msg + "</h3><p>You scored " + pct + "% — " + state.score + " correct out of " + total + " questions.</p><button class=\"btn-quiz-nav gold\" style=\"margin:0 auto;display:flex\" type=\"button\" id=\"retry-" + moduleId + "\">↺ Retry Quiz</button></div>";
  var retryBtn = document.getElementById("retry-" + moduleId);
  if (retryBtn) retryBtn.addEventListener("click", function(){state.current=0;state.answers={};state.score=0;state.done=false;render();});
  try{var d=JSON.parse(localStorage.getItem("npa")||'{"pv":0,"pages":{},"quiz":{}}');if(!d.quiz)d.quiz={};if(!d.quiz[moduleId])d.quiz[moduleId]=[];d.quiz[moduleId].push({score:state.score,total:total,ts:Date.now()});localStorage.setItem("npa",JSON.stringify(d));}catch(e){}
}
document.addEventListener("DOMContentLoaded", render);
</script>
