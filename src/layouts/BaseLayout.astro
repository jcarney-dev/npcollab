---
// src/layouts/BaseLayout.astro
// The main shell: sidebar + topbar + page content
// To add a new nav item: add an entry to the navItems arrays below

export interface Props {
  title: string;
  section?: string;
  breadcrumb?: string;
}

const { title, section = '', breadcrumb = '' } = Astro.props;
const base = import.meta.env.BASE_URL;

// ── NAV STRUCTURE ─────────────────────────────────────
// To add a new page: add { label, href, icon } to the
// appropriate group. Active state is handled automatically.
// For coming soon items: add disabled: true, coming: true
const currentPath = Astro.url.pathname;

const navGroups = [
  {
    label: 'Getting Started',
    items: [
      { label: 'Home',               href: `${base}`,                  icon: '🏠' },
      { label: 'Introduction',       href: `${base}intro/`,            icon: '👋' },
      { label: 'Metaspecialties',    href: `${base}metaspecialties/`,  icon: '🗺️' },
      { label: 'Starting Your Role', href: `${base}starting-role/`,    icon: '🚀' },
      { label: 'Scope of Practice',  href: `${base}scope/`,            icon: '🛡️' },
      { label: 'Patient Assessment', href: `${base}assessment/`,       icon: '📋' },
    ]
  },
  {
    label: 'Clinical Modules',
    items: [
      { label: 'Aged Care',             href: `${base}modules/aged-care/`,           icon: '🧓', disabled: true, coming: true },
      { label: 'Cardiac',               href: `${base}modules/cardiac/`,             icon: '❤️' },
      { label: 'Cardiovascular',        href: `${base}modules/cardiovascular/`,      icon: '🫀', disabled: true, coming: true },
      { label: 'Drugs & Alcohol',       href: `${base}modules/drugs-alcohol/`,       icon: '🧪', disabled: true, coming: true },
      { label: 'Endocrine',             href: `${base}modules/endocrine/`,           icon: '🔬', disabled: true, coming: true },
      { label: 'ENT',                   href: `${base}modules/ent/`,                 icon: '👂' },
      { label: 'General Medical',       href: `${base}modules/general-medical/`,     icon: '🩺', disabled: true, coming: true },
      { label: 'GI & Hepatobiliary',    href: `${base}modules/gi-hepatobiliary/`,    icon: '🫃', disabled: true, coming: true },
      { label: 'GU & Nephrology',       href: `${base}modules/gu-nephrology/`,       icon: '🫘', disabled: true, coming: true },
      { label: 'Integumentary',         href: `${base}modules/integumentary/`,       icon: '🩹', disabled: true, coming: true },
      { label: 'Maxillofacial/Dental',  href: `${base}modules/maxillofacial-dental/`,icon: '🦷', disabled: true, coming: true },
      { label: "Men's Health",          href: `${base}modules/mens-health/`,         icon: '👨', disabled: true, coming: true },
      { label: 'Mental Health',         href: `${base}modules/mental-health/`,       icon: '🧠', disabled: true, coming: true },
      { label: 'Musculoskeletal',       href: `${base}modules/musculoskeletal/`,     icon: '🦴', disabled: true, coming: true },
      { label: 'Neurology',             href: `${base}modules/neurology/`,           icon: '🧬', disabled: true, coming: true },
      { label: 'Onco-Haematology',      href: `${base}modules/onco-haematology/`,   icon: '🩸', disabled: true, coming: true },
      { label: 'Ophthalmology',         href: `${base}modules/eyes/`,               icon: '👁️' },
      { label: 'Paediatrics',           href: `${base}modules/paediatrics/`,         icon: '👶', disabled: true, coming: true },
      { label: 'Palliative Care',       href: `${base}modules/palliative-care/`,     icon: '🕊️', disabled: true, coming: true },
      { label: 'Respiratory',           href: `${base}modules/respiratory/`,         icon: '🫁' },
      { label: 'Surgical',              href: `${base}modules/surgical/`,            icon: '🔪', disabled: true, coming: true },
      { label: 'Toxicology',            href: `${base}modules/toxicology/`,          icon: '⚗️', disabled: true, coming: true },
      { label: "Women's Health",        href: `${base}modules/womens-health/`,       icon: '👩', disabled: true, coming: true },
    ]
  },
  {
    label: 'Clinical Practice Essentials',
    items: [
      { label: 'Billing Medicare',      href: `${base}clinical-essentials/billing-medicare/`,    icon: '💳' },
      { label: 'Prescribing & the PBS', href: `${base}clinical-essentials/prescribing-pbs/`,     icon: '💊' },
      { label: 'Radiology & Pathology', href: `${base}clinical-essentials/radiology-pathology/`, icon: '🔬' },
    ]
  },
  {
    label: 'Health Tech & Tools',
    items: [
      { label: 'AI Clinical Tools', href: `${base}health-tech/ai-clinical-tools/`, icon: '🤖' },
      { label: 'Digital Scribes',   href: `${base}health-tech/digital-scribes/`,   icon: '🎙️' },
      { label: 'Medical Software',  href: `${base}health-tech/medical-software/`,  icon: '💻' },
    ]
  },
  {
    label: 'Research',
    items: [
      { label: 'Getting Started', href: `${base}research/getting-started/`, icon: '🔭' },
      { label: 'Funding',         href: `${base}research/funding/`,         icon: '💰' },
      { label: 'Networks',        href: `${base}research/networks/`,        icon: '🌐' },
    ]
  },
  {
    label: 'Business',
    items: [
      { label: 'Starting Your Own Practice', href: `${base}business/`, icon: '🏢', disabled: true, coming: true },
    ]
  },
  {
    label: 'Site',
    items: [
      { label: 'About & Contributors', href: `${base}about/`,     icon: '👥' },
      { label: 'Support NPCollab',     href: `${base}support/`,   icon: '❤️' },
      { label: 'Analytics',            href: `${base}analytics/`, icon: '📊' },
    ]
  }
];

function isActive(href: string) {
  if (href === '#') return false;
  if (href === base || href === base + '/') {
    return currentPath === base || currentPath === base + '/';
  }
  return currentPath.startsWith(href);
}
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} — NPCollab</title>
  <meta name="description" content="NPCollab - A free collaborative clinical learning resource for Australian Nurse Practitioners and NP students." />
  <link rel="stylesheet" href={`${base}styles/global.css`} />

  <!-- Analytics: replace with your Plausible or GA4 snippet -->
  <!-- <script defer data-domain="npcollab.com" src="https://plausible.io/js/script.js"></script> -->
</head>
<body>
<div class="app-shell">

  <!-- ══════ SIDEBAR ══════ -->
  <aside class="sidebar" id="sidebar">
    <div class="sidebar-logo">
      <a href={base} class="wordmark">NP<span>Collab</span></a>
      <span class="tagline">Australian Nurse Practitioner Resources</span>
    </div>

    <nav class="sidebar-nav">
      {navGroups.map(group => (
        <div>
          <span class="nav-section-label">{group.label}</span>
          {group.items.map(item => (
            <a
              href={item.disabled ? undefined : item.href}
              class={`nav-item ${isActive(item.href) ? 'active' : ''} ${item.disabled ? 'disabled' : ''}`}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              <span class="nav-icon" aria-hidden="true">{item.icon}</span>
              {item.label}
              {item.coming && <span style="margin-left:auto;font-size:0.6rem;background:rgba(255,255,255,0.1);padding:2px 6px;border-radius:3px;color:rgba(255,255,255,0.4)">SOON</span>}
            </a>
          ))}
        </div>
      ))}
    </nav>

    <div class="sidebar-footer">
      <div class="support-badge">
        <p>Free forever for Australian NPs. Help cover hosting costs.</p>
        <a href={`${base}support/`} class="btn-support">☕ Support NPCollab</a>
      </div>
    </div>
  </aside>

  <div class="overlay" id="overlay" onclick="closeSidebar()"></div>

  <!-- ══════ MAIN ══════ -->
  <div class="main-content">

    <header class="topbar">
      <div style="display:flex;align-items:center;gap:14px">
        <button class="hamburger" onclick="toggleSidebar()" aria-label="Open menu">
          <svg width="22" height="22" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
        </button>
        <div class="topbar-breadcrumb">
          <a href={base} style="color:var(--text-muted);text-decoration:none">NPCollab</a>
          {breadcrumb && <span> → <span>{breadcrumb}</span></span>}
        </div>
      </div>
      <div class="topbar-actions">
        <span class="pill-badge">🇦🇺 AU Resources</span>
        <span class="pill-badge">AHPRA Aligned</span>
      </div>
    </header>

    <main class="page-content">
      <slot />
    </main>

    <footer class="page-footer">
      <div>© {new Date().getFullYear()} NPCollab · Built by NPs, for NPs ·
        <a href="https://www.nursingmidwiferyboard.gov.au" target="_blank" rel="noopener">NMBA</a> ·
        <a href="https://www.ahpra.gov.au" target="_blank" rel="noopener">AHPRA</a>
      </div>
      <div>⚠️ Educational purposes only. Always apply your own clinical judgement.</div>
    </footer>
  </div>
</div>

<script>
  function toggleSidebar() {
    document.getElementById('sidebar')!.classList.toggle('open');
    document.getElementById('overlay')!.classList.toggle('show');
  }
  function closeSidebar() {
    document.getElementById('sidebar')!.classList.remove('open');
    document.getElementById('overlay')!.classList.remove('show');
  }
  // Make closeSidebar available globally for the overlay onclick
  (window as any).toggleSidebar = toggleSidebar;
  (window as any).closeSidebar = closeSidebar;
</script>
</body>
</html>
