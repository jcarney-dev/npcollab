# NPCollab — Required Environment Variables
# Copy this file to .env.local for local development
# Set all variables in Vercel project settings for production

# Neon Postgres (pooler URL from Neon dashboard → Connection string → Pooled connection)
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.ap-southeast-2.aws.neon.tech/neondb?sslmode=require

# Resend (https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@contact.npcollab.com.au

# Admin
ADMIN_EMAIL=jason.carney@gmail.com
ADMIN_PASSWORD=your-secure-admin-password

# Cookie signing — generate with: openssl rand -base64 32
ACCESS_COOKIE_SECRET=your-32-plus-character-random-secret-here

# Site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://npcollab.com
